{
  "name": "homelibrary-app",
  "version": "1.0.1",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "overrides": {
    "glob": "13.0.6",
    "jsdom": "29.0.0",
    "uuid": "11.1.1"
  },
  "scripts": {
    "postinstall": "npm run generate:app-icons && npm run prepare:fastlane-icon",
    "generate:app-icons": "node scripts/generate-app-icons.mjs",
    "prepare:fastlane-icon": "node scripts/prepare-fastlane-icon.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/inject-web-runtime-config.mjs",
    "validate:android-release": "node scripts/validate-android-release.mjs",
    "audit:fdroid-npm": "node scripts/check-fdroid-npm-dependencies.mjs",
    "check:fdroid-icons": "node scripts/check-fdroid-icons.mjs",
    "validate:fdroid-metadata": "node scripts/validate-fdroid-metadata.mjs",
    "build:fdroid-android": "bash scripts/build-fdroid-android.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "7.18.18",
    "@react-navigation/native": "7.3.18",
    "@react-navigation/native-stack": "7.18.10",
    "@tanstack/react-query": "^5.28.0",
    "expo": "~58.0.0",
    "expo-blob": "~58.0.1",
    "expo-camera": "~58.0.7",
    "expo-file-system": "~58.0.5",
    "expo-image": "~58.0.10",
    "expo-image-manipulator": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-localization": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.3",
    "i18next": "^26.4.2",
    "pocketbase": "^0.21.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.13",
    "react-native": "0.88.0-rc.3",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-web": "~0.21.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "babel-preset-expo": "~58.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "expo-doctor": "1.20.4",
    "globals": "16.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~58.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.69.0"
  },
  "license": "GPL-3.0-or-later",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          ".*"
        ]
      }
    },
    "install": {
      "exclude": [
        "expo",
        "expo-camera"
      ]
    }
  }
}
